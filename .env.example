# ============================================================================
# Pitwall IQ — environment configuration (root reference)
# Copy the relevant blocks into backend/.env and frontend/.env.local.
# NOTHING here is required for the app to run on open F1 data.
# Secrets (F1 TV token, LLM key) are read ONLY by the backend and are never
# exposed to the browser.
# ============================================================================

# ---------------------------------------------------------------------------
# BACKEND  (backend/.env)
# ---------------------------------------------------------------------------

# Explicit demo mode: serve clearly-labelled simulated sample data instead of
# fetching real data. This is a DEVELOPER/OFFLINE switch only — the website uses
# real data by default and NEVER silently substitutes demo data for a failed
# real fetch (it shows an honest error + retry instead).
PITWALL_IQ_MOCK_MODE=false

# Try real pitwall/FastF1 data first (recommended). Set false to stay fully offline.
PITWALL_IQ_ENABLE_LIVE=true

# Use FastF1 (richer laps/telemetry) when available. Requires f1pitwall[full].
PITWALL_IQ_USE_FASTF1=true

# Seconds before a single upstream fetch gives up.
PITWALL_IQ_FETCH_TIMEOUT=30

# Where normalized real sessions are cached on disk.
PITWALL_IQ_CACHE_DIR=backend/data/cache
PITWALL_IQ_CACHE_TTL_HOURS=720

# Default season shown first in the UI.
PITWALL_IQ_DEFAULT_YEAR=2026

# Comma-separated allowed CORS origins (the frontend URL).
PITWALL_IQ_CORS=http://localhost:3000

# --- PRIVATE PRODUCT ANALYTICS (optional; see docs/ANALYTICS.md) ---

# Where analytics events are stored. On Render, attaching a PostgreSQL instance
# injects DATABASE_URL automatically and nothing else is needed. Locally you can
# point at a SQLite file instead. LEAVE BOTH UNSET AND ANALYTICS SIMPLY DOES NOT
# RUN — the site behaves exactly as it does today, and no request path changes.
# DATABASE_URL=postgresql://user:pass@host/dbname
# PITWALL_IQ_ANALYTICS_DB=sqlite://./backend/data/analytics.db

# The single secret guarding the /admin dashboard. UNSET MEANS THE ADMIN API IS
# OFF — every analytics route answers 503 rather than serving data, which is the
# only safe default for a deployment that has not been configured yet.
# Must be at least 24 characters. Generate one with:
#     python -c "import secrets; print(secrets.token_urlsafe(32))"
# NEVER put this in the frontend build — you paste it into /admin once and the
# browser keeps it in localStorage.
# PITWALL_IQ_ADMIN_TOKEN=

# Emergency off-switch for event recording, without removing the database.
PITWALL_IQ_ANALYTICS=true

# --- OPTIONAL secrets (server-side only) ---

# F1 TV Premium token — ONLY needed for live car telemetry/GPS during a live
# session. The whole app works without it on open/free data. Never sent to the client.
# F1TV_TOKEN=

# LLM key — OPTIONAL. If set, natural-language answers may be polished for wording.
# The facts always come from the deterministic engine; no key is ever required.
# ANTHROPIC_API_KEY=
# PITWALL_IQ_LLM_MODEL=claude-opus-4-8

# ---------------------------------------------------------------------------
# FRONTEND  (frontend/.env.local)
# ---------------------------------------------------------------------------

# Base URL of the backend API. Inlined at build time (safe, non-secret).
# Local default is http://localhost:8000; set this to your deployed backend URL
# in production. The legacy NEXT_PUBLIC_API_BASE is still honored as a fallback.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
