# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.env
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- backend data ---
backend/data/cache/*.json
!backend/data/cache/.gitkeep
# remembered upstream documents (calendars, standings, historical results) —
# see app/upstream.py; regenerated on demand, never part of the source tree
backend/data/cache/upstream/
# local analytics store (production uses Render Postgres) — see docs/ANALYTICS.md
*.db
*.db-wal
*.db-shm
# FastF1's own on-disk cache, if created next to the package
fastf1_cache/

# --- Node / Next.js ---
node_modules/
.next/
out/
.turbo/
npm-debug.log*
yarn-error.log*

# --- env / secrets ---
.env
.env.local
.env.*.local
*.local

# --- editor / OS ---
.DS_Store
.vscode/
.idea/
*.swp

# TS incremental build cache
frontend/tsconfig.tsbuildinfo
*.tsbuildinfo

# --- release bundles ---
# Each `pitwalliqv<N>.bundle` is a git bundle of this very repository, produced
# for delivery. Committing one would nest a copy of the history inside the
# history it was made from, and add ~1 MB per version forever.
*.bundle
